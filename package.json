{
  "name": "@waldbaer/node-red-retry",
  "version": "1.1.0",
  "description": "Configurable retry mechanism for Node-RED flows.",
  "author": "waldbaer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waldbaer/node-red-retry.git"
  },
  "keywords": [
    "node-red",
    "retry",
    "retries",
    "error",
    "errorhandling"
  ],
  "node-red": {
    "version": ">=1.3.0",
    "nodes": {
      "retry": "nodes/retry.js"
    }
  },
  "engines": {
    "node": ">=8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "mocha": "12.0.3",
    "mocha-suppress-logs": "0.6.0",
    "node-red": "5.0.8",
    "node-red-dev": "0.1.6",
    "node-red-node-test-helper": "0.3.6",
    "nyc": "18.0.0"
  },
  "nyc": {
    "check-coverage": true,
    "reporter": [
      "lcov",
      "text",
      "text-summary"
    ],
    "branches": 100,
    "lines": 100,
    "functions": 100,
    "statements": 100
  },
  "scripts": {
    "test": "mocha --timeout 10000 --require mocha-suppress-logs \"test/**/*_spec.js\"",
    "test_verbose": "mocha --timeout 10000 \"test/**/*_spec.js\"",
    "coverage": "nyc npm test",
    "lint": "eslint nodes resources test",
    "node-red-dev-validate": "node-red-dev validate -p ."
  }
}
